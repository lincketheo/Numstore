// clang-format off
// AUTO GENERATED - DO NOT MODIFY
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include "core/ns_error.h"
#include "core/ns_logging.h"
#include "core/ns_testing.h"
#include "core/os/ns_malloc.h"
#include "core/os/ns_os.h"

int
main (int argc, char **argv)
{
  if (!(argc == 2 || argc == 3))
  {
    fprintf (stderr, "Usage: %s seed [FILTER]\n", argv[0]);
    return EXIT_FAILURE;
  }
  // Unbuffered: a crash or abort must not swallow the tail of the log, and
  // make's stderr must not interleave ahead of our stdout. The last line
  // printed is then genuinely the last line reached.
  setvbuf (stdout, NULL, _IONBF, 0);

  u64 seed = strtoul(argv[1], NULL, 10);
  const char *filter = (argc == 3) ? argv[2] : NULL;

  srand(seed);

  int ntests = 0;
  error   e = error_create ();

  // The harness runs on the real OS - each test body gets its own
  struct i_os harness_os;
  if (system_os_create (default_mem (), &harness_os, &e) != SUCCESS)
  {
    return -1;
  }

  i_timer timer;
  if (harness_os.table->timer_create (harness_os.self, &timer, &e) != SUCCESS)
  {
    system_os_free (harness_os);
    return -1;
  }
  int         failed = 0;
  const char *failed_names[%TEST_COUNT%];
  %CALLS%
  printf (
      "Time: %llu ms\n",
      (unsigned long long)(timer.table->timer_now_ns (timer.self) / 1000000ULL)
  );
  harness_os.table->timer_free (harness_os.self, timer.self);
  system_os_free (harness_os);
  if (failed)
  {
    i_log_failure ("FAILED TESTS (%d):\n", failed);
    for (int i = 0; i < failed; i++)
    {
      i_log_failure ("  %s\n", failed_names[i]);
    }
  }
  else
  {
    i_log_passed ("ALL %d TESTS PASSED\n", ntests);
  }
  return test_ret;
}
// clang-format on
